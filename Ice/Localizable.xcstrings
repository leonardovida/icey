        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 아래 시간 동안 메뉴 막대를 벗어나 있으면 메뉴 막대 항목을 다시 숨김."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "Icey can work in a limited mode without this permission." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tohoto oprávnění může Icey fungovat v omezeném režimu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kann ohne diese Berechtigung eingeschränkt verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey puede funcionar en modo limitado sin este permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey peut fonctionner en mode limité sans cette autorisation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey dapat bekerja dalam mode terbatas tanpa izin ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey può funzionare in modalità limitata senza questo permesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この権限がなくても、Icey は制限モードで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 권한 없이도 Icey를 제한 모드로 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kan zonder deze toestemming in een beperkte modus werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego uprawnienia Icey może działać w trybie ograniczonym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey pode funcionar em modo limitado sem esta permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey может работать в ограниченном режиме без этого разрешения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kan användas i ett begränsat läge utan den här behörigheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey สามารถทำงานในโหมดจำกัดได้โดยไม่ต้องมีสิทธิ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey bu izin olmadan sınırlı bir modda çalışabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey може працювати в обмеженому режимі без цього дозволу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey có thể hoạt động ở chế độ giới hạn khi không có quyền này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有此权限，Icey 仍可以受限模式运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有此權限，Icey 仍可以受限模式執行。"
          }
        }
      }
    },
    "Icey cannot hide items on this version of macOS: the system interface it relies on is missing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey nemůže v této verzi macOS skrývat položky: chybí systémové rozhraní, na kterém závisí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kann in dieser macOS-Version keine Elemente ausblenden: Die benötigte Systemschnittstelle fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey no puede ocultar elementos en esta versión de macOS: falta la interfaz del sistema de la que depende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ne peut pas masquer d’éléments dans cette version de macOS : l’interface système dont il dépend est absente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey tidak dapat menyembunyikan item di versi macOS ini: antarmuka sistem yang diperlukannya tidak ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey non può nascondere elementi in questa versione di macOS: manca l’interfaccia di sistema su cui si basa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンの macOS では、Icey は項目を非表示にできません。必要なシステムインターフェイスがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 macOS에서는 Icey가 항목을 가릴 수 없습니다. 필요한 시스템 인터페이스가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kan in deze versie van macOS geen onderdelen verbergen: de systeeminterface die het nodig heeft, ontbreekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey nie może ukrywać elementów w tej wersji macOS: brakuje interfejsu systemowego, którego wymaga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey não pode ocultar itens nesta versão do macOS: a interface do sistema da qual ele depende não existe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey не может скрывать элементы в этой версии macOS: отсутствует системный интерфейс, на который он опирается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey kan inte dölja objekt i den här versionen av macOS: systemgränssnittet som krävs saknas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ไม่สามารถซ่อนรายการใน macOS เวอร์ชั่นนี้ได้ เนื่องจากไม่มีอินเทอร์เฟซระบบที่ Icey ต้องใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey bu macOS sürümünde öğeleri gizleyemez: dayandığı sistem arabirimi eksik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey не може ховати елементи в цій версії macOS: відсутній системний інтерфейс, на який він спирається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey không thể ẩn các mục trên phiên bản macOS này: thiếu giao diện hệ thống mà Icey cần dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

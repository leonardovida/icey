    "%@ — cannot be hidden on this version of macOS" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — v této verzi macOS nelze skrýt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — kann in dieser macOS-Version nicht ausgeblendet werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — no se puede ocultar en esta versión de macOS"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — ne peut pas être masqué dans cette version de macOS"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — tidak dapat disembunyikan di versi macOS ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — non può essere nascosto in questa versione di macOS"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — このバージョンの macOS では非表示にできません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 이 버전의 macOS에서는 가릴 수 없습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — kan in deze versie van macOS niet worden verborgen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — nie można ukryć w tej wersji macOS"
          }

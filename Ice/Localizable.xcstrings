    "Note: You may need to log out and back in for this setting to apply properly." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: Aby se toto nastavení správně uplatnilo, může být nutné se odhlásit a znovu přihlásit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Möglicherweise musst du dich ab- und wieder anmelden, damit diese Einstellung korrekt angewendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: puede que debas cerrar sesión y volver a iniciarla para aplicar correctamente este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : il peut être nécessaire de fermer puis de rouvrir votre session pour appliquer correctement ce réglage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan: Anda mungkin perlu keluar dari akun lalu masuk kembali agar pengaturan ini diterapkan dengan benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: potrebbe essere necessario uscire e ripetere il login perché questa impostazione venga applicata correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：設定を正しく適用するには、ログアウトして再度ログインする必要がある場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 설정을 올바르게 적용하려면 로그아웃한 후 다시 로그인해야 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: Mogelijk moet je uitloggen en opnieuw inloggen voordat deze instelling goed wordt toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: Aby to ustawienie zostało prawidłowo zastosowane, może być konieczne wylogowanie się i ponowne zalogowanie."

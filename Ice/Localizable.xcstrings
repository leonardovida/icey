    "Drag to arrange your menu bar items into different sections." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením rozmístěte položky řádku nabídek do různých sekcí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Menüleistenelemente, um sie in verschiedene Bereiche einzuordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para organizar los elementos de la barra de menús en distintas secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments de la barre des menus pour les répartir dans différentes sections."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk mengatur item bar menu Anda ke dalam bagian yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per disporre gli elementi della barra dei menu in sezioni diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグしてメニューバー項目を各セクションに配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 메뉴 막대 항목을 다른 영역으로 정렬하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep je menubalkonderdelen om ze in verschillende secties in te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągaj elementy paska menu, aby rozmieścić je w różnych sekcjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para organizar os itens da barra de menus em seções diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте элементы строки меню, чтобы распределить их по разделам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra dina menyradsobjekt för att ordna dem i olika sektioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อจัดเรียงรายการแถบเมนูของคุณไว้ในส่วนต่างๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu öğelerinizi farklı bölümlere yerleştirmek için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте елементи смуги меню, щоб розподілити їх між розділами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp các mục trên thanh menu vào các phần khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以将菜单栏项目排列到不同的区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以將選單列項目排列到不同的區域。"
          }
        }
      }
    },
    "Due to a bug in a previous version of the app, the data for Ice’s menu bar sections was corrupted and had to be reset." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli chybě v předchozí verzi aplikace byla data sekcí řádku nabídek aplikace Ice poškozena a musela být resetována."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgrund eines Fehlers in einer früheren Version der App waren die Daten der Menüleistenbereiche von Ice beschädigt und mussten zurückgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debido a un error en una versión anterior de la app, los datos de las secciones de la barra de menús de Ice se dañaron y tuvieron que restablecerse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En raison d’un bug dans une version précédente de l’app, les données des sections de la barre des menus d’Ice étaient corrompues et ont dû être réinitialisées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karena bug di versi app sebelumnya, data bagian bar menu Ice rusak dan harus diatur ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di un bug in una versione precedente dell’app, i dati delle sezioni della barra dei menu di Ice erano danneggiati e sono stati ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンの不具合により、Ice のメニューバーのセクションのデータが破損したため、リセットする必要がありました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 버전 앱의 버그로 인해 Ice의 메뉴 막대 영역 데이터가 손상되어 재설정해야 했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door een fout in een eerdere versie van de app waren de gegevens van de menubalksecties van Ice beschadigd en moesten ze opnieuw worden ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z powodu błędu we wcześniejszej wersji aplikacji dane sekcji paska menu Ice zostały uszkodzone i trzeba było je zresetować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devido a um erro em uma versão anterior do app, os dados das seções da barra de menus do Ice foram corrompidos e tiveram que ser redefinidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из-за ошибки в предыдущей версии приложения данные разделов строки меню Ice были повреждены, и их пришлось сбросить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På grund av en bugg i en tidigare version av appen skadades data för menyradssektionerna i Ice och måste återställas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เนื่องจากข้อบกพร่องในแอปเวอร์ชั่นก่อนหน้า ข้อมูลส่วนต่างๆ ของแถบเมนูของ Ice เสียหายและต้องรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın önceki bir sürümündeki bir hata nedeniyle Ice’ın menü çubuğu bölümlerine ait veriler bozuldu ve sıfırlanması gerekti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через помилку в попередній версії програми дані розділів смуги меню Ice було пошкоджено, тож їх довелося скинути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do lỗi trong phiên bản trước của ứng dụng, dữ liệu các phần thanh menu của Ice đã bị hỏng và phải được đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于旧版 App 中的一个错误，Ice 的菜单栏区域数据已损坏，必须重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於舊版 App 中的一個錯誤，Ice 的選單列區域資料已損毀，必須重置。"
          }
        }
      }
    },

        }
      }
    },
    "Icey will replace its settings with the %lld settings in this file, then quit and open again to apply them. Settings that are not in the file stay as they are." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey nahradí svá nastavení %lld nastaveními z tohoto souboru, poté se ukončí a znovu otevře, aby je použila. Nastavení, která v souboru nejsou, zůstanou beze změny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ersetzt seine Einstellungen durch die %lld Einstellungen in dieser Datei und wird dann beendet und erneut geöffnet, um sie anzuwenden. Einstellungen, die nicht in der Datei enthalten sind, bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sustituirá sus ajustes por los %lld ajustes de este archivo y, después, se cerrará y se volverá a abrir para aplicarlos. Los ajustes que no estén en el archivo no cambiarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey va remplacer ses réglages par les %lld réglages de ce fichier, puis se fermer et se rouvrir pour les appliquer. Les réglages absents du fichier restent inchangés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey akan mengganti pengaturannya dengan %lld pengaturan dalam file ini, lalu berhenti dan dibuka kembali untuk menerapkannya. Pengaturan yang tidak ada di dalam file tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sostituirà le sue impostazioni con le %lld impostazioni di questo file, quindi si chiuderà e si riaprirà per applicarle. Le impostazioni non presenti nel file restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey は現在の設定をこのファイル内の %lld 件の設定で置き換え、適用するために終了してから再度開きます。ファイルに含まれていない設定はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey는 설정을 이 파일에 있는 %lld개의 설정으로 대체한 후, 적용하기 위해 종료했다가 다시 엽니다. 파일에 없는 설정은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey vervangt zijn instellingen door de %lld instellingen in dit bestand en stopt en opent daarna opnieuw om ze toe te passen. Instellingen die niet in het bestand staan, blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey zastąpi swoje ustawienia %lld ustawieniami z tego pliku, a następnie zakończy działanie i otworzy się ponownie, aby je zastosować. Ustawienia, których nie ma w pliku, pozostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey substituirá os ajustes pelos %lld ajustes deste arquivo e, em seguida, encerrará e abrirá novamente para aplicá-los. Os ajustes que não estiverem no arquivo permanecem como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey заменит свои настройки настройками из этого файла (количество: %lld), затем завершит работу и откроется снова, чтобы применить их. Настройки, которых нет в файле, останутся без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ersätter sina inställningar med de %lld inställningarna i den här filen och avslutas och öppnas sedan igen för att använda dem. Inställningar som inte finns i filen förblir oförändrade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey จะแทนที่การตั้งค่าด้วยการตั้งค่า %lld รายการในไฟล์นี้ จากนั้นจะออกและเปิดใหม่เพื่อนำไปใช้ การตั้งค่าที่ไม่ได้อยู่ในไฟล์จะยังคงเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ayarlarını bu dosyadaki %lld ayarla değiştirecek, ardından bunları uygulamak için kapanıp yeniden açılacak. Dosyada olmayan ayarlar olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey замінить свої параметри параметрами з цього файлу (кількість: %lld), потім завершить роботу й відкриється знову, щоб застосувати їх. Параметри, яких немає у файлі, залишаться без змін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sẽ thay thế cài đặt hiện tại bằng %lld cài đặt trong tệp này, sau đó thoát và mở lại để áp dụng. Các cài đặt không có trong tệp sẽ được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 将用此文件中的 %lld 项设置替换当前设置，然后退出并重新打开以应用这些设置。文件中没有的设置将保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 將以此檔案中的 %lld 項設定取代目前的設定，然後結束並重新打開以套用這些設定。檔案中沒有的設定將保持不變。"
          }
        }
      }
    },

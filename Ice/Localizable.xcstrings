          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access Icey's settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím zobrazíte skryté položky řádku nabídek. Kliknutím pravým tlačítkem otevřete nastavení Icey."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken, um ausgeblendete Menüleistenelemente anzuzeigen. Rechtsklick öffnet die Einstellungen von Icey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para mostrar los elementos ocultos de la barra de menús. Haz clic derecho para acceder a los ajustes de Icey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour afficher les éléments masqués de la barre des menus. Cliquez avec le bouton droit pour accéder aux réglages d’Icey."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik untuk menampilkan item bar menu yang tersembunyi. Klik kanan untuk membuka pengaturan Icey."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic per mostrare gli elementi nascosti della barra dei menu. Fai clic destro per accedere alle impostazioni di Icey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックすると隠れているメニューバー項目を表示します。右クリックでIceyの設定を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 숨겨진 메뉴 막대 항목을 표시합니다. 오른쪽 클릭하면 Icey 설정에 접근합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik om verborgen menubalkonderdelen te tonen. Klik met de rechtermuisknop voor de instellingen van Icey."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij, aby pokazać ukryte elementy paska menu. Kliknij prawym przyciskiem, aby otworzyć ustawienia Icey."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique para mostrar os itens ocultos da barra de menus. Clique com o botão direito para acessar os ajustes do Icey."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы показать скрытые элементы строки меню. Нажмите правой кнопкой мыши, чтобы открыть настройки Icey."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka för att visa dolda menyradsobjekt. Högerklicka för att öppna inställningarna för Icey."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกเพื่อแสดงรายการแถบเมนูที่ซ่อนอยู่ คลิกขวาเพื่อเข้าถึงการตั้งค่าของ Icey"

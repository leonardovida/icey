    "Quit and reopen them yourself, or log out, for the new spacing to take effect." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby se nové rozestupy projevily, ukončete tyto aplikace a sami je znovu otevřete, nebo se odhlaste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende diese Apps selbst und öffne sie erneut oder melde dich ab, damit der neue Abstand wirksam wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciérralas y vuelve a abrirlas tú mismo, o cierra sesión, para que se aplique el nuevo espaciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez-les et rouvrez-les vous-même, ou fermez votre session, pour que le nouvel espacement prenne effet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dan buka kembali app tersebut sendiri, atau keluar dari akun, agar jarak baru berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudile e riaprile manualmente, oppure esci dall’account, perché la nuova spaziatura abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい間隔を反映するには、これらのアプリを手動で終了して再度開くか、ログアウトしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 간격을 적용하려면 해당 앱을 직접 종료한 후 다시 열거나 로그아웃하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop deze apps zelf en open ze opnieuw, of log uit, zodat de nieuwe tussenruimte van kracht wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ te aplikacje i otwórz je ponownie samodzielnie lub wyloguj się, aby nowe odstępy zaczęły obowiązywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre e abra esses apps novamente por conta própria, ou encerre a sessão, para que o novo espaçamento entre em vigor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы новый интервал вступил в силу, завершите их и откройте снова вручную или выйдите из системы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta och öppna apparna igen själv, eller logga ut, för att det nya avståndet ska börja gälla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากแอปเหล่านั้นแล้วเปิดใหม่ด้วยตัวเอง หรือออกจากระบบ เพื่อให้ระยะห่างใหม่มีผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni aralığın geçerli olması için bu uygulamalardan kendiniz çıkıp yeniden açın veya oturumu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб новий інтервал набув чинності, закрийте їх і відкрийте знову вручну або вийдіть із системи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tự thoát và mở lại các ứng dụng đó, hoặc đăng xuất, để khoảng cách mới có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请自行退出并重新打开这些 App，或者退出登录，以使新的间距生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請自行結束並重新打開這些 App，或登出，以使新的間距生效。"
          }
        }
      }
    },

          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey จะเก็บการตั้งค่าของจอภาพเหล่านี้ไว้สำหรับเมื่อเชื่อมต่ออีกครั้ง"

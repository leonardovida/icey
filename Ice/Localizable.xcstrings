    "\"%@\" took too long to respond" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat zu lange nicht reagiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ha tardado demasiado en responder"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a mis trop de temps à répondre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha impiegato troppo tempo a rispondere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の応答に時間がかかりすぎました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 응답 시간이 너무 오래 걸렸습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” demorou demais para responder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”响应时间过长"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」回應時間過長"
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht und kann erst nach einem Neustart verschoben werden. Bis das Problem behoben ist, kann auch das Verschieben anderer Menüleistenelemente beeinträchtigt sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde y no se puede mover hasta que se reinicie. El movimiento de otros elementos de la barra de menús también puede verse afectado hasta que se resuelva el problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas et ne peut pas être déplacé avant son redémarrage. Le déplacement d’autres éléments de la barre des menus peut aussi être affecté jusqu’à la résolution du problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Finché non viene riavviato, non può essere spostato. Anche lo spostamento degli altri elementi della barra dei menu potrebbe risentirne finché il problema non viene risolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が応答していません。再起動するまで移動できません。解決するまで、他のメニューバー項目の移動にも影響する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않습니다. 다시 시작할 때까지 이동할 수 없습니다. 이 문제가 해결될 때까지 다른 메뉴 막대 항목의 이동에도 영향을 줄 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está respondendo. Até que seja reiniciado, ele não pode ser movido. A movimentação de outros itens da barra de menus também pode ser afetada até que isso seja resolvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，重新启动该应用后才能移动。在此问题解决前，其他菜单栏项目的移动也可能受到影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有回應，重新啟動該應用程式後才能移動。在此問題解決前，其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },

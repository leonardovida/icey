          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеи без выреза показывают скрытые элементы в строке меню."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

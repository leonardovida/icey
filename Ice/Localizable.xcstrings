        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgens de instelling ‘Algemeen’ toont dit beeldscherm verborgen menubalkonderdelen in de menubalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите или смахните в строке меню, чтобы показать скрытые элементы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulla eller svep i menyraden för att visa dolda menyradsobjekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนหรือปัดในแถบเมนูเพื่อแสดงรายการแถบเมนูที่ซ่อนอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli menü çubuğu öğelerini göstermek için menü çubuğunda kaydırın veya kaydırma hareketi yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутіть або проведіть у смузі меню, щоб показати приховані елементи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn hoặc vuốt trên thanh menu để hiển thị các mục bị ẩn trên thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏中滚动或轻扫以显示隐藏的菜单栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列中捲動或滑動以顯示隱藏的選單列項目。"
          }
        }

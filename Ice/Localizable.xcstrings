    "Displays without a notch show hidden menu bar items in the menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory bez výřezu zobrazují skryté položky řádku nabídek přímo v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays ohne Aussparung zeigen ausgeblendete Menüleistenelemente in der Menüleiste an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas sin muesca muestran los elementos ocultos en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans sans encoche affichent les éléments masqués dans la barre des menus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

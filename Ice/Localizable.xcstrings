          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые версии загружаются в фоновом режиме и устанавливаются при завершении работы Icey."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

    "Click inside an empty area of the menu bar to show hidden menu bar items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím do prázdné oblasti řádku nabídek zobrazíte skryté položky řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einen leeren Bereich der Menüleiste klicken, um ausgeblendete Elemente anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un área vacía de la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {

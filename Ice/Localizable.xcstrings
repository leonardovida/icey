          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey precisa de permissão para gerenciar a barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

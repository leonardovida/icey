    },
    "Icey keeps the settings of these displays for when they are connected again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey behält die Einstellungen dieser Displays für den Fall, dass sie wieder verbunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey conserva los ajustes de estas pantallas para cuando se vuelvan a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey conserve les réglages de ces écrans pour le moment où ils seront reconnectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey conserva le impostazioni di questi schermi per quando verranno ricollegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのディスプレイの設定は、再接続したときのために Icey が保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey는 이 디스플레이들이 다시 연결될 때를 위해 설정을 보관합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey mantém os ajustes destas telas para quando elas forem conectadas novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 会保留这些显示器的设置，以便重新连接时使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 會保留這些顯示器的設定，以便重新連接時使用。"
          }
        }
      }
    },
    "Icey moves each menu bar item it hasn't seen before to this section once. Items you move afterwards stay where you put them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey verschiebt jedes Menüleistenelement, das es noch nicht kennt, einmalig in diesen Bereich. Elemente, die du danach verschiebst, bleiben dort, wo du sie abgelegt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey mueve una vez a esta sección cada elemento de la barra de menús que no haya visto antes. Los elementos que muevas después se quedan donde los pongas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey déplace une seule fois dans cette section chaque élément de la barre des menus qu’il n’a encore jamais vu. Les éléments que vous déplacez ensuite restent là où vous les placez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sposta una sola volta in questa sezione ogni elemento della barra dei menu che non ha mai visto prima. Gli elementi che sposti in seguito restano dove li metti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey は、初めて検出したメニューバー項目を一度だけこのセクションに移動します。その後に移動した項目は、置いた場所にそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey는 처음 보는 메뉴 막대 항목을 이 영역으로 한 번만 이동합니다. 이후에 이동한 항목은 놓은 위치에 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey move uma única vez para esta seção cada item da barra de menus que ainda não conhece. Os itens que você mover depois ficam onde você os colocar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 会将每个首次出现的菜单栏项目移到此区域一次。之后你移动的项目会保留在你放置的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 會將每個首次出現的選單列項目移到此區域一次。之後你移動的項目會保留在你放置的位置。"
          }
        }
      }
    },
    "Icey needs the Screen Recording permission to change the menu bar's appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey benötigt die Berechtigung „Bildschirmaufnahme“, um das Erscheinungsbild der Menüleiste zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "Already enabled in System Settings? Remove Icey from the list, then add it again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už je povoleno v Nastavení systému? Odeberte Icey ze seznamu a pak ji přidejte znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits in den Systemeinstellungen aktiviert? Entferne Icey aus der Liste und füge es dann erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está activado en Ajustes del Sistema? Elimina Icey de la lista y vuelve a añadirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà activé dans Réglages Système ? Supprimez Icey de la liste, puis ajoutez-le à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah diaktifkan di Pengaturan Sistem? Hapus Icey dari daftar, lalu tambahkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già attivato in Impostazioni di Sistema? Rimuovi Icey dall’elenco, quindi aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定ですでに有効になっていますか？リストから Icey を削除してから、もう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 이미 활성화되어 있습니까? 목록에서 Icey를 제거한 다음 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ingeschakeld in Systeeminstellingen? Verwijder Icey uit de lijst en voeg het dan opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już włączone w Ustawieniach systemowych? Usuń Icey z listy, a następnie dodaj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está ativado nos Ajustes do Sistema? Remova o Icey da lista e adicione-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже включено в Системных настройках? Удалите Icey из списка, затем добавьте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redan aktiverat i Systeminställningar? Ta bort Icey från listan och lägg sedan till det igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานในการตั้งค่าระบบแล้วหรือไม่ ให้เอา Icey ออกจากรายการ แล้วเพิ่มกลับเข้าไปใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları’nda zaten etkin mi? Icey’yi listeden kaldırın ve yeniden ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже ввімкнено в Системних параметрах? Вилучіть Icey зі списку, а потім додайте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã bật trong Cài đặt hệ thống? Hãy xóa Icey khỏi danh sách rồi thêm lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在“系统设置”中启用？请从列表中移除 Icey，然后重新添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在「系統設定」中啟用？請從列表中移除 Icey，然後再重新加入。"
          }
        }
      }
    },

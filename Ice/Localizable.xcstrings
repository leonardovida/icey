    "Menu bar items are rehidden once the pointer has been away from the menu bar for the time below." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky řádku nabídek se znovu skryjí, jakmile je ukazatel mimo řádek nabídek po dobu nastavenou níže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menüleistenelemente werden wieder ausgeblendet, sobald der Zeiger für die unten eingestellte Zeit außerhalb der Menüleiste war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos se vuelven a ocultar cuando el puntero lleva fuera de la barra de menús el tiempo indicado abajo."

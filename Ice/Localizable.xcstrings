    "Wider displays show hidden menu bar items in the menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Širší monitory zobrazují skryté položky řádku nabídek přímo v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breitere Displays zeigen ausgeblendete Menüleistenelemente in der Menüleiste an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas más anchas muestran los elementos ocultos en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans plus larges affichent les éléments masqués dans la barre des menus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar yang lebih lebar menampilkan item bar menu yang tersembunyi di bar menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schermi più larghi mostrano gli elementi nascosti nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それより広いディスプレイでは、隠れているメニューバー項目をメニューバーに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 넓은 디스플레이에서는 숨겨진 메뉴 막대 항목을 메뉴 막대에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bredere beeldschermen tonen verborgen menubalkonderdelen in de menubalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szersze wyświetlacze pokazują ukryte elementy paska menu na pasku menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As telas mais largas mostram os itens ocultos na barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более широкие дисплеи показывают скрытые элементы в строке меню."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bredare skärmar visar dolda menyradsobjekt i menyraden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพที่กว้างกว่าจะแสดงรายการแถบเมนูที่ซ่อนอยู่ในแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey peut fonctionner en mode limité sans cette autorisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey può funzionare in modalità limitata senza questo permesso."
          }
        },
        "ja" : {
          "stringUnit" : {

    "Items can also be arranged by ⌘ Command + dragging them in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente lassen sich auch mit gedrückter ⌘-Befehlstaste direkt in der Menüleiste ziehen und anordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes organizar los elementos arrastrándolos en la barra de menús con ⌘ Comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi organiser les éléments en les faisant glisser dans la barre des menus avec ⌘ Commande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disporre gli elementi anche trascinandoli nella barra dei menu con ⌘ Comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Commandキーを押しながらメニューバーで項目をドラッグしても並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Command 키를 누른 채 메뉴 막대에서 항목을 드래그해도 정렬할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens também podem ser organizados arrastando-os na barra de menus com ⌘ Comando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以按住 ⌘ Command 键在菜单栏中拖移项目来排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以按住 ⌘ Command 鍵在選單列中拖移項目來排列。"
          }
        }
      }
    },

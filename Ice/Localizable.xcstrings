        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대를 관리하려면 Icey에 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "The General setting shows hidden menu bar items in the menu bar on this display." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podle nastavení „Obecné“ tento monitor zobrazuje skryté položky řádku nabídek přímo v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut der Einstellung „Allgemein“ zeigt dieses Display ausgeblendete Menüleistenelemente in der Menüleiste an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el ajuste General, esta pantalla muestra los elementos ocultos en la barra de menús."

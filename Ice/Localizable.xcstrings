    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nereaguje. Až do opětovného spuštění jej nelze přesunout. Dokud se problém nevyřeší, může být ovlivněno i přesouvání dalších položek řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht und kann erst nach einem Neustart verschoben werden. Bis das Problem behoben ist, kann auch das Verschieben anderer Menüleistenelemente beeinträchtigt sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde y no se puede mover hasta que se reinicie. El movimiento de otros elementos de la barra de menús también puede verse afectado hasta que se resuelva el problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas et ne peut pas être déplacé avant son redémarrage. Le déplacement d’autres éléments de la barre des menus peut aussi être affecté jusqu’à la résolution du problème."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak merespons dan tidak dapat dipindahkan sampai dimulai ulang. Pemindahan item bar menu lain juga mungkin terpengaruh sampai masalah ini teratasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Finché non viene riavviato, non può essere spostato. Anche lo spostamento degli altri elementi della barra dei menu potrebbe risentirne finché il problema non viene risolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が応答していません。再起動するまで移動できません。解決するまで、他のメニューバー項目の移動にも影響する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않습니다. 다시 시작할 때까지 이동할 수 없습니다. 이 문제가 해결될 때까지 다른 메뉴 막대 항목의 이동에도 영향을 줄 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reageert niet en kan pas worden verplaatst nadat het opnieuw is opgestart. Totdat dit is opgelost, kan ook het verplaatsen van andere menubalkonderdelen problemen geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiada. Do czasu ponownego uruchomienia nie można go przenieść. Do czasu rozwiązania problemu może to również utrudniać przenoszenie innych elementów paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está respondendo. Até que seja reiniciado, ele não pode ser movido. A movimentação de outros itens da barra de menus também pode ser afetada até que isso seja resolvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отвечает, и его нельзя переместить до перезапуска. Пока проблема не устранена, перемещение других элементов строки меню также может работать неправильно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarar inte och kan inte flyttas förrän det har startats om. Tills problemet är löst kan det även påverka flyttningen av andra menyradsobjekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่ตอบสนองและไม่สามารถย้ายได้จนกว่าจะเริ่มการทำงานใหม่ การย้ายรายการแถบเมนูอื่นๆ อาจได้รับผลกระทบด้วยจนกว่าปัญหานี้จะได้รับการแก้ไข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıt vermiyor. Yeniden başlatılana kadar taşınamaz. Bu sorun çözülene kadar diğer menü çubuğu öğelerinin taşınması da etkilenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не відповідає, і його не можна перемістити до перезапуску. Доки проблему не усунуто, переміщення інших елементів смуги меню також може працювати неправильно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không phản hồi và không thể di chuyển cho đến khi được khởi động lại. Việc di chuyển các mục khác trên thanh menu cũng có thể bị ảnh hưởng cho đến khi sự cố được giải quyết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，重新启动该应用后才能移动。在此问题解决前，其他菜单栏项目的移动也可能受到影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有回應，重新啟動該應用程式後才能移動。在此問題解決前，其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },

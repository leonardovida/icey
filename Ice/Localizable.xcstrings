    "Icey needs your permission to manage the menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey potřebuje oprávnění ke správě řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey benötigt die Berechtigung, die Menüleiste zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey necesita permiso para gestionar la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey a besoin d’une autorisation pour gérer la barre des menus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey memerlukan izin Anda untuk mengelola bar menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey ha bisogno del permesso per gestire la barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーを管理するには、Iceyに権限が必要です。"

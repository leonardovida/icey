            "value" : "Icey kann ohne diese Berechtigung eingeschränkt verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey puede funcionar en modo limitado sin este permiso."
          }
        },

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы строки меню снова скрываются, когда указатель находится вне строки меню в течение заданного ниже времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyradsobjekt döljs igen när pekaren har varit utanför menyraden under tiden nedan."

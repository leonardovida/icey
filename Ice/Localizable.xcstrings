    "Icey looks for a new version once a day and lets you know when one is available." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey jednou denně vyhledá novou verzi a upozorní vás, až bude k dispozici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sucht einmal am Tag nach einer neuen Version und gibt dir Bescheid, wenn eine verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey busca una nueva versión una vez al día y te avisa cuando hay una disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey recherche une nouvelle version une fois par jour et vous prévient lorsqu’elle est disponible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey mencari versi baru sekali sehari dan memberi tahu Anda jika tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey cerca una nuova versione una volta al giorno e ti avvisa quando è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey は 1 日に 1 回新しいバージョンを確認し、利用可能になったときに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey는 하루에 한 번 새 버전을 확인하고, 새 버전이 있으면 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey zoekt één keer per dag naar een nieuwe versie en laat het je weten als er een beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey raz dziennie szuka nowej wersji i powiadamia, gdy jest dostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey procura uma nova versão uma vez por dia e avisa você quando houver uma disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey раз в день проверяет наличие новой версии и сообщает, когда она доступна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey söker efter en ny version en gång om dagen och meddelar dig när en finns tillgänglig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey จะตรวจหาเวอร์ชันใหม่วันละครั้งและแจ้งให้คุณทราบเมื่อมีเวอร์ชันใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey günde bir kez yeni sürüm olup olmadığını denetler ve yeni sürüm olduğunda size bildirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey раз на день перевіряє наявність нової версії й повідомляє, коли вона доступна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey tìm phiên bản mới mỗi ngày một lần và thông báo cho bạn khi có phiên bản mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 每天检查一次新版本，有新版本时会通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 每天檢查一次新版本，有新版本時會通知你。"
          }
        }
      }
    },
    "Icey moves each menu bar item it hasn't seen before to this section once. Items you move afterwards stay where you put them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey jednou přesune do této sekce každou položku řádku nabídek, kterou dosud neviděla. Položky, které přesunete potom, zůstanou tam, kam je umístíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey verschiebt jedes Menüleistenelement, das es noch nicht kennt, einmalig in diesen Bereich. Elemente, die du danach verschiebst, bleiben dort, wo du sie abgelegt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey mueve una vez a esta sección cada elemento de la barra de menús que no haya visto antes. Los elementos que muevas después se quedan donde los pongas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey déplace une seule fois dans cette section chaque élément de la barre des menus qu’il n’a encore jamais vu. Les éléments que vous déplacez ensuite restent là où vous les placez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey memindahkan setiap item bar menu yang belum pernah dilihatnya ke bagian ini satu kali. Item yang Anda pindahkan setelahnya tetap berada di tempat Anda meletakkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey sposta una sola volta in questa sezione ogni elemento della barra dei menu che non ha mai visto prima. Gli elementi che sposti in seguito restano dove li metti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey は、初めて検出したメニューバー項目を一度だけこのセクションに移動します。その後に移動した項目は、置いた場所にそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey는 처음 보는 메뉴 막대 항목을 이 영역으로 한 번만 이동합니다. 이후에 이동한 항목은 놓은 위치에 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey verplaatst elk menubalkonderdeel dat het nog niet eerder heeft gezien eenmalig naar deze sectie. Onderdelen die je daarna verplaatst, blijven waar je ze neerzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey jednorazowo przenosi do tej sekcji każdy nowy element paska menu. Elementy, które przeniesiesz później, pozostaną tam, gdzie je umieścisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Icey move uma única vez para esta seção cada item da barra de menus que ainda não conhece. Os itens que você mover depois ficam onde você os colocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey однократно перемещает в этот раздел каждый новый для него элемент строки меню. Элементы, которые вы переместите после этого, останутся там, куда вы их поместили."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey flyttar varje menyradsobjekt som det inte har sett tidigare till den här sektionen en gång. Objekt som du flyttar efteråt stannar där du placerar dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey จะย้ายรายการแถบเมนูแต่ละรายการที่ไม่เคยพบมาก่อนมาไว้ที่ส่วนนี้หนึ่งครั้ง รายการที่คุณย้ายหลังจากนั้นจะอยู่ในตำแหน่งที่คุณวางไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey daha önce görmediği her menü çubuğu öğesini bir kez bu bölüme taşır. Sonradan taşıdığınız öğeler bıraktığınız yerde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey один раз переміщує до цього розділу кожен новий для нього елемент смуги меню. Елементи, які ви перемістите після цього, залишаться там, де ви їх розмістили."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey chuyển mỗi mục mới trên thanh menu vào phần này một lần. Các mục bạn di chuyển sau đó sẽ giữ nguyên vị trí bạn đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 会将每个首次出现的菜单栏项目移到此区域一次。之后你移动的项目会保留在你放置的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey 會將每個首次出現的選單列項目移到此區域一次。之後你移動的項目會保留在你放置的位置。"
          }
        }
      }
    },
    "Icey needs the Screen Recording permission to change the menu bar's appearance." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {

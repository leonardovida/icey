        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: talvez seja necessário encerrar e iniciar a sessão novamente para que este ajuste seja aplicado corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание. Чтобы эта настройка применилась правильно, может потребоваться выйти из системы и войти снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

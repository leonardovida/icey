    "Right-click in an empty area of the menu bar to display a minimal version of Icey's menu. Disable this setting if you encounter conflicts with other apps." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím pravým tlačítkem do prázdné oblasti řádku nabídek zobrazíte zjednodušenou verzi nabídky Icey. Pokud dochází ke konfliktům s jinými aplikacemi, toto nastavení vypněte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick in einen leeren Bereich der Menüleiste zeigt eine reduzierte Version des Icey-Menüs. Deaktiviere diese Einstellung bei Konflikten mit anderen Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en un área vacía de la barra de menús para mostrar una versión reducida del menú de Icey. Desactiva este ajuste si tienes conflictos con otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez avec le bouton droit dans une zone vide de la barre des menus pour afficher une version réduite du menu d’Icey. Désactivez ce réglage en cas de conflit avec d’autres apps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik kanan area kosong pada bar menu untuk menampilkan versi ringkas menu Icey. Nonaktifkan pengaturan ini jika terjadi konflik dengan app lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro in un’area vuota della barra dei menu per mostrare una versione ridotta del menu di Icey. Disattiva questa impostazione se riscontri conflitti con altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分を右クリックすると、Iceyの簡易メニューが表示されます。ほかのアプリと競合する場合はこの設定をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역을 오른쪽 클릭하면 Icey 메뉴의 간소화된 버전이 표시됩니다. 다른 앱과 충돌이 발생하면 이 설정을 끄십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een leeg gedeelte van de menubalk om een beknopte versie van het Icey-menu te tonen. Schakel deze instelling uit als je conflicten met andere apps ondervindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie prawym przyciskiem pustego obszaru paska menu wyświetla uproszczoną wersję menu Icey. Wyłącz to ustawienie, jeśli występują konflikty z innymi aplikacjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma área vazia da barra de menus para exibir uma versão reduzida do menu do Icey. Desative este ajuste se houver conflitos com outros apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите правой кнопкой мыши в пустой области строки меню, чтобы показать сокращенную версию меню Icey. Выключите эту настройку, если возникают конфликты с другими приложениями."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på ett tomt område i menyraden för att visa en förenklad version av Iceys meny. Avaktivera inställningen om den orsakar konflikter med andra appar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกขวาในพื้นที่ว่างของแถบเมนูเพื่อแสดงเมนูของ Icey แบบย่อ ปิดการตั้งค่านี้หากเกิดความขัดแย้งกับแอปอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey menüsünün sade bir sürümünü görüntülemek için menü çubuğunda boş bir alana sağ tıklayın. Başka uygulamalarla çakışma yaşarsanız bu ayarı kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою миші в порожній області смуги меню, щоб показати скорочену версію меню Icey. Вимкніть цей параметр, якщо виникають конфлікти з іншими програмами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm chuột phải vào vùng trống trên thanh menu để hiển thị phiên bản rút gọn của menu Icey. Hãy tắt cài đặt này nếu bạn gặp xung đột với các ứng dụng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏的空白区域右键点按可显示精简版的 Icey 菜单。如果与其他 App 冲突，请停用此设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列的空白區域按右鍵可顯示精簡版的 Icey 選單。如果與其他 App 衝突，請停用此設定。"
          }
        }
      }
    },

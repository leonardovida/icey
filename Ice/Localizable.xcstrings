    "New versions download in the background and install when Icey quits." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové verze se stahují na pozadí a nainstalují se při ukončení Icey."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Versionen werden im Hintergrund geladen und beim Beenden von Icey installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas versiones se descargan en segundo plano y se instalan al cerrarse Icey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles versions sont téléchargées en arrière-plan et installées à la fermeture d’Icey."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi baru diunduh di latar belakang dan diinstal saat Icey keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove versioni vengono scaricate in background e installate alla chiusura di Icey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンをバックグラウンドでダウンロードし、Icey の終了時にインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

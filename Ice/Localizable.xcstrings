        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma área vazia da barra de menus para mostrar os itens ocultos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите в пустой области строки меню, чтобы показать скрытые элементы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på ett tomt område i menyraden för att visa dolda menyradsobjekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกในพื้นที่ว่างของแถบเมนูเพื่อแสดงรายการแถบเมนูที่ซ่อนอยู่"

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Согласно настройке на панели «Основные», этот дисплей показывает скрытые элементы в строке меню."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enligt inställningen ”Allmänt” visar den här skärmen dolda menyradsobjekt i menyraden."

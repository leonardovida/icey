          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分をクリックして、隠れているメニューバー項目を表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역을 클릭하여 숨겨진 메뉴 막대 항목 표시."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

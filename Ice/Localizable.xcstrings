        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está activado en Ajustes del Sistema? Elimina Icey de la lista y vuelve a añadirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

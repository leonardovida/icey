    "Hover over an empty area of the menu bar to show hidden menu bar items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najetím na prázdnou oblast řádku nabídek zobrazíte skryté položky řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über einen leeren Bereich der Menüleiste fahren, um ausgeblendete Elemente anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el cursor sobre un área vacía de la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan penunjuk ke area kosong pada bar menu untuk menampilkan item bar menu yang tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il puntatore su un’area vuota della barra dei menu per mostrare gli elementi nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分にポインタを置いて、隠れているメニューバー項目を表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역 위에 포인터를 올려 숨겨진 메뉴 막대 항목 표시."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de aanwijzer over een leeg gedeelte van de menubalk om verborgen menubalkonderdelen te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najechanie na pusty obszar paska menu pokazuje ukryte elementy paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o cursor sobre uma área vazia da barra de menus para mostrar os itens ocultos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите указатель на пустую область строки меню, чтобы показать скрытые элементы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll pekaren över ett tomt område i menyraden för att visa dolda menyradsobjekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางตัวชี้เหนือพื้นที่ว่างของแถบเมนูเพื่อแสดงรายการแถบเมนูที่ซ่อนอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli menü çubuğu öğelerini göstermek için imleci menü çubuğunda boş bir alanın üzerine getirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведіть вказівник на порожню область смуги меню, щоб показати приховані елементи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di con trỏ lên vùng trống trên thanh menu để hiển thị các mục bị ẩn trên thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鼠标悬停在菜单栏的空白区域，即可显示隐藏的菜单栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將游標移至選單列的空白區域以顯示隱藏的選單列項目。"
          }
        }
      }
    },

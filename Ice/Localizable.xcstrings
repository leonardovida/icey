    "Scroll or swipe in the menu bar to show hidden menu bar items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutím nebo přejetím prsty v řádku nabídek zobrazíte skryté položky řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Menüleiste scrollen oder streichen, um ausgeblendete Elemente anzuzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate o desliza en la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler ou balayez la barre des menus pour afficher les éléments masqués."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir atau gesek di bar menu untuk menampilkan item bar menu yang tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri nella barra dei menu per mostrare gli elementi nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーでスクロールまたはスワイプして、隠れているメニューバー項目を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에서 스크롤하거나 쓸어넘겨 숨겨진 메뉴 막대 항목을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrol of veeg in de menubalk om verborgen menubalkonderdelen te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewinięcie lub przesunięcie palcami na pasku menu pokazuje ukryte elementy paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey потрібен ваш дозвіл для керування смугою меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey cần sự cho phép của bạn để quản lý thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

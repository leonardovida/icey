          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schermi senza notch mostrano gli elementi nascosti nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチのないディスプレイでは、隠れているメニューバー項目をメニューバーに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치가 없는 디스플레이에서는 숨겨진 메뉴 막대 항목을 메뉴 막대에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeldschermen zonder inkeping tonen verborgen menubalkonderdelen in de menubalk."

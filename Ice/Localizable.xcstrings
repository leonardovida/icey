    "Icey keeps the settings of these displays for when they are connected again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey uchovává nastavení těchto monitorů pro případ, že budou znovu připojeny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey behält die Einstellungen dieser Displays für den Fall, dass sie wieder verbunden werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey conserva los ajustes de estas pantallas para cuando se vuelvan a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey conserve les réglages de ces écrans pour le moment où ils seront reconnectés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icey menyimpan pengaturan layar ini untuk digunakan saat layar tersebut tersambung kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

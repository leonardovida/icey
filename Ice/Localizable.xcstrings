    "Please try again. If the error persists, please file a bug report." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste to znovu. Pokud chyba přetrvává, nahlaste ji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versuche es erneut. Wenn der Fehler weiterhin auftritt, melde ihn bitte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Si el error persiste, informa del problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez réessayer. Si l’erreur persiste, signalez le problème."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba lagi. Jika kesalahan berlanjut, kirimkan laporan bug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova. Se l’errore persiste, segnala il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。問題が続く場合は不具合をご報告ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하세요. 문제가 계속되면 오류를 보고해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het opnieuw. Als de fout blijft optreden, meld dan een bug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie. Jeśli błąd będzie się powtarzał, zgłoś go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente novamente. Se o erro persistir, relate o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите попытку. Если ошибка не исчезнет, отправьте отчет об ошибке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök igen. Om felet kvarstår kan du rapportera en bugg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดลองอีกครั้ง หากยังเกิดข้อผิดพลาดอยู่ โปรดส่งรายงานข้อบกพร่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen yeniden deneyin. Hata devam ederse lütfen bir hata raporu gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте ще раз. Якщо помилка не зникне, надішліть звіт про помилку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng thử lại. Nếu lỗi vẫn tiếp diễn, vui lòng gửi báo cáo lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重试。如果问题仍然存在，请提交问题报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重試。如果問題仍然存在，請提交問題報告。"
          }
        }
      }
    },
